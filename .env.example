# Frontend (Vite). Copy to .env.local and restart `npm run dev` after changing.

# REAL (default): every number comes from the RetailEdge backend. If it is unreachable the UI says Offline / Not configured.
# DEMO: the built-in sample fixtures, labelled "DEMO DATA" everywhere. Never used as a silent fallback.
# VITE_DATA_MODE=real

# URL of the RetailEdge API. `npm run dev` defaults to http://127.0.0.1:8000; a production build MUST set it.
# VITE_API_URL=http://127.0.0.1:8000
# (VITE_CAMERA_API_URL is still accepted as an alias.)

# Phones on a controlled LAN: see backend/docs/LAN_DEPLOYMENT.md (VITE_API_URL=http://<pc-lan-ip>:8000 and `npm run dev -- --host`).
